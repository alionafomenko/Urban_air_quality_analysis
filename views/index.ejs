<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIINfQqznM3b7wq8e7pXXbnTF38Zk5bUDk="
        crossorigin=""
    >
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="app-layout">
        <aside class="side-toolbar" aria-label="Головна навігація">
            <div class="side-brand">
                <span class="side-logo">ІС</span>
                <div>
                    <strong>Аналіз повітря</strong>
                    <small>Міська система</small>
                </div>
            </div>

            <nav class="side-nav">
                <a class="active" href="/">Панель аналізу</a>
                <a href="/events">Журнал подій</a>
                <a href="/directories">Довідники</a>
            </nav>
        </aside>

        <main class="page">
        <section class="hero">
            <p class="eyebrow">Аналіз якості повітря в місті</p>
            <h1><%= pageTitle %></h1>
            <p class="description">
                Дипломний проєкт для збору, збереження, візуалізації та аналізу показників якості повітря з віртуальних IoT-датчиків.
            </p>
        </section>

        <div class="dashboard-grid">
            <section class="dashboard-section stats-column">
                <div class="section-header stacked">
                    <div>
                        <p class="eyebrow dark">Поточний стан</p>
                        <h2>Панель статистики</h2>
                    </div>
                    <span class="table-count" id="filtered-count"><%= sensors.length %> датчиків</span>
                </div>

                <div class="stats-grid" aria-label="Статистика системи">
                    <article class="stat-card">
                        <span>Усього датчиків</span>
                        <strong id="stat-total">0</strong>
                    </article>

                    <article class="stat-card">
                        <span>Активні за 24 години</span>
                        <strong id="stat-active">0</strong>
                    </article>

                    <article class="stat-card">
                        <span>Середня температура</span>
                        <strong id="stat-temp">—</strong>
                    </article>

                    <article class="stat-card">
                        <span>Середня вологість</span>
                        <strong id="stat-humidity">—</strong>
                    </article>

                    <article class="stat-card">
                        <span>Середній рівень пилу</span>
                        <strong id="stat-dust">—</strong>
                    </article>

                    <article class="stat-card">
                        <span>Найбільш забруднений датчик</span>
                        <strong id="stat-worst">—</strong>
                    </article>
                </div>
            </section>

            <div class="map-column">
                <section class="dashboard-section filters-section">
                    <div class="section-header">
                        <div>
                            <p class="eyebrow dark">Фільтри</p>
                            <h2>Відбір датчиків</h2>
                        </div>
                        <button class="reset-button" type="button" id="reset-filters">Скинути</button>
                    </div>

                    <div class="filter-panel">
                        <div class="filter-group">
                            <label>Забруднення повітря</label>
                            <div class="quality-tabs" role="tablist" aria-label="Рівень забруднення">
                                <button class="quality-tab active" type="button" data-level="all">Усі</button>
                                <button class="quality-tab low" type="button" data-level="low">Низьке</button>
                                <button class="quality-tab medium" type="button" data-level="medium">Середнє</button>
                                <button class="quality-tab high" type="button" data-level="high">Високе</button>
                            </div>
                        </div>

                        <div class="filter-group">
                            <label for="sensor-filter">Датчик</label>
                            <select id="sensor-filter">
                                <option value="all">Усі датчики</option>
                                <% sensors.forEach((sensor) => { %>
                                    <option value="<%= sensor.id %>"><%= sensor.name %></option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="filter-group">
                            <label for="time-filter">Час останнього вимірювання</label>
                            <select id="time-filter">
                                <option value="all">Будь-коли</option>
                                <option value="1">За останню годину</option>
                                <option value="6">За останні 6 годин</option>
                                <option value="24">За останні 24 години</option>
                            </select>
                        </div>

                        <div class="filter-group range-group">
                            <label>Температура, °C</label>
                            <div>
                                <input id="temp-min" type="number" placeholder="від">
                                <input id="temp-max" type="number" placeholder="до">
                            </div>
                        </div>

                        <div class="filter-group range-group">
                            <label>Пил</label>
                            <div>
                                <input id="dust-min" type="number" placeholder="від">
                                <input id="dust-max" type="number" placeholder="до">
                            </div>
                        </div>
                    </div>

                    <div class="quality-legend" aria-label="Позначення якості повітря">
                        <span><i class="legend-dot low"></i> Низьке забруднення</span>
                        <span><i class="legend-dot medium"></i> Середнє забруднення</span>
                        <span><i class="legend-dot high"></i> Високе забруднення</span>
                        <span><i class="legend-dot unknown"></i> Немає вимірювань</span>
                    </div>
                </section>

                <section class="map-section">
                    <div class="section-header">
                        <div>
                            <p class="eyebrow dark">Карта датчиків</p>
                            <h2>Розташування датчиків у Києві</h2>
                        </div>
                        <span class="table-count"><%= sensors.length %> датчиків</span>
                    </div>

                    <% if (mapError) { %>
                        <div class="error-box"><%= mapError %></div>
                    <% } %>

                    <div id="sensor-map" class="sensor-map" aria-label="Карта розташування датчиків"></div>
                </section>

                <section class="sensor-analysis" id="sensor-analysis">
                    <div class="section-header">
                        <div>
                            <p class="eyebrow dark">Детальний аналіз</p>
                            <h2>Аналіз вибраного датчика</h2>
                        </div>

                        <div class="period-tabs" aria-label="Період графіка">
                            <button class="period-tab" type="button" data-hours="1">1 година</button>
                            <button class="period-tab" type="button" data-hours="6">6 годин</button>
                            <button class="period-tab active" type="button" data-hours="24">24 години</button>
                        </div>
                    </div>

                    <p class="empty-analysis" id="analysis-empty">
                        Виберіть датчик на карті, щоб переглянути історію його вимірювань.
                    </p>

                    <div class="analysis-content" id="analysis-content" hidden>
                        <div class="selected-sensor">
                            <div>
                                <span>Вибраний датчик</span>
                                <strong id="selected-sensor-name">—</strong>
                            </div>
                            <span class="level-badge" id="selected-sensor-level">немає даних</span>
                        </div>

                        <div class="mini-metrics">
                            <div>
                                <span>Температура</span>
                                <strong id="selected-temperature">—</strong>
                            </div>
                            <div>
                                <span>Вологість</span>
                                <strong id="selected-humidity">—</strong>
                            </div>
                            <div>
                                <span>Пил</span>
                                <strong id="selected-dust">—</strong>
                            </div>
                            <div>
                                <span>AQI</span>
                                <strong id="selected-aqi">—</strong>
                            </div>
                        </div>

                        <p class="chart-status" id="chart-status"></p>
                        <div class="chart-panel">
                            <canvas id="sensor-history-chart"></canvas>
                        </div>
                    </div>
                </section>
            </div>
        </div>
        </main>
    </div>

    <script
        src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
        crossorigin=""
    ></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>
    <script>
        const sensors = <%- sensorsJson %>;
        const kyivCenter = [50.4501, 30.5234];
        const levelColors = {
            low: "#1f9d55",
            medium: "#d99a00",
            high: "#d94636",
            no_data: "#64748b"
        };
        let selectedSensor = null;
        let selectedMarker = null;
        let selectedPeriodHours = 24;
        let historyChart = null;

        window.addEventListener("load", () => {
            const map = L.map("sensor-map", {
                center: kyivCenter,
                zoom: 11,
                scrollWheelZoom: true
            });

            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                maxZoom: 19,
                attribution: "&copy; OpenStreetMap"
            }).addTo(map);

            const markers = new Map();

            map.on("click", () => {
                clearSelectedSensor();
            });

            sensors.forEach((sensor) => {
                const marker = L.circleMarker([sensor.latitude, sensor.longitude], {
                    radius: 7,
                    color: "#ffffff",
                    weight: 2,
                    fillColor: levelColors[sensor.pollution_level] || levelColors.no_data,
                    fillOpacity: 0.9,
                    bubblingMouseEvents: false
                }).addTo(map);

                marker.bindPopup(`
                    <strong>${sensor.name}</strong><br>
                    Забруднення повітря: ${getLevelLabel(sensor.pollution_level)}<br>
                    Температура: ${formatNumber(sensor.temperature, " °C")}<br>
                    Вологість: ${formatNumber(sensor.humidity, " %")}<br>
                    Пил: ${formatNumber(sensor.dust, "")}<br>
                    AQI: ${formatNumber(sensor.aqi, "")}
                `);

                marker.on("click", () => {
                    selectSensor(sensor, marker);
                });

                markers.set(String(sensor.id), marker);
            });

            setTimeout(() => {
                map.invalidateSize();
            }, 200);

            const filters = {
                level: "all",
                sensor: document.getElementById("sensor-filter"),
                time: document.getElementById("time-filter"),
                tempMin: document.getElementById("temp-min"),
                tempMax: document.getElementById("temp-max"),
                dustMin: document.getElementById("dust-min"),
                dustMax: document.getElementById("dust-max")
            };

            const qualityTabs = document.querySelectorAll(".quality-tab");

            qualityTabs.forEach((tab) => {
                tab.addEventListener("click", () => {
                    filters.level = tab.dataset.level;

                    qualityTabs.forEach((item) => {
                        item.classList.toggle("active", item.dataset.level === filters.level);
                    });

                    applyFilters();
                });
            });

            [
                filters.sensor,
                filters.time,
                filters.tempMin,
                filters.tempMax,
                filters.dustMin,
                filters.dustMax
            ].forEach((field) => {
                field.addEventListener("input", applyFilters);
                field.addEventListener("change", applyFilters);
            });

            document.getElementById("reset-filters").addEventListener("click", () => {
                filters.level = "all";
                filters.sensor.value = "all";
                filters.time.value = "all";
                filters.tempMin.value = "";
                filters.tempMax.value = "";
                filters.dustMin.value = "";
                filters.dustMax.value = "";

                qualityTabs.forEach((item) => {
                    item.classList.toggle("active", item.dataset.level === "all");
                });

                applyFilters();
            });

            document.querySelectorAll(".period-tab").forEach((button) => {
                button.addEventListener("click", () => {
                    selectedPeriodHours = Number(button.dataset.hours);

                    document.querySelectorAll(".period-tab").forEach((item) => {
                        item.classList.toggle("active", item === button);
                    });

                    if (selectedSensor) {
                        loadSensorHistory(selectedSensor.id, selectedPeriodHours);
                    }
                });
            });

            function applyFilters() {
                const visibleSensors = sensors.filter((sensor) => {
                    if (filters.level !== "all" && sensor.pollution_level !== filters.level) {
                        return false;
                    }

                    if (filters.sensor.value !== "all" && String(sensor.id) !== filters.sensor.value) {
                        return false;
                    }

                    if (!matchesTime(sensor.last_measurement_at, filters.time.value)) {
                        return false;
                    }

                    if (!matchesRange(sensor.temperature, filters.tempMin.value, filters.tempMax.value)) {
                        return false;
                    }

                    if (!matchesRange(sensor.dust, filters.dustMin.value, filters.dustMax.value)) {
                        return false;
                    }

                    return true;
                });

                markers.forEach((marker, sensorId) => {
                    const isVisible = visibleSensors.some((sensor) => String(sensor.id) === sensorId);

                    if (isVisible) {
                        marker.addTo(map);
                    } else {
                        marker.remove();
                    }
                });

                updateStats(visibleSensors);
            }

            applyFilters();
        });

        function selectSensor(sensor, marker) {
            selectedSensor = sensor;

            if (selectedMarker) {
                selectedMarker.setStyle({
                    radius: 7,
                    weight: 2
                });
            }

            selectedMarker = marker;
            selectedMarker.setStyle({
                radius: 10,
                weight: 3
            });

            document.getElementById("analysis-empty").hidden = true;
            document.getElementById("analysis-content").hidden = false;
            document.getElementById("selected-sensor-name").textContent = sensor.name;
            document.getElementById("selected-temperature").textContent = formatNumber(sensor.temperature, " °C");
            document.getElementById("selected-humidity").textContent = formatNumber(sensor.humidity, " %");
            document.getElementById("selected-dust").textContent = formatNumber(sensor.dust, "");
            document.getElementById("selected-aqi").textContent = formatNumber(sensor.aqi, "");

            const levelBadge = document.getElementById("selected-sensor-level");
            levelBadge.textContent = getLevelLabel(sensor.pollution_level);
            levelBadge.className = `level-badge ${sensor.pollution_level || "no_data"}`;

            loadSensorHistory(sensor.id, selectedPeriodHours);
        }

        function clearSelectedSensor() {
            selectedSensor = null;

            if (selectedMarker) {
                selectedMarker.setStyle({
                    radius: 7,
                    weight: 2
                });
                selectedMarker = null;
            }

            document.getElementById("analysis-empty").hidden = false;
            document.getElementById("analysis-content").hidden = true;
        }

        async function loadSensorHistory(sensorId, hours) {
            const status = document.getElementById("chart-status");
            status.textContent = "Завантаження історії вимірювань...";

            try {
                const response = await fetch(`/api/sensors/${sensorId}/history?hours=${hours}`);

                if (!response.ok) {
                    throw new Error("History request failed");
                }

                const history = await response.json();
                renderHistoryChart(history);
                status.textContent = history.length
                    ? `Показано ${history.length} вимірювань за вибраний період.`
                    : "За вибраний період немає вимірювань.";
            } catch (error) {
                status.textContent = "Не вдалося завантажити історію. Перевірте SQL-функцію для графіка.";
                renderHistoryChart([]);
            }
        }

        function renderHistoryChart(history) {
            const canvas = document.getElementById("sensor-history-chart");

            if (!window.Chart) {
                document.getElementById("chart-status").textContent = "Бібліотека графіків не завантажилась.";
                return;
            }

            const labels = history.map((item, index) => {
                if (!item.created_at) {
                    return `#${index + 1}`;
                }

                return new Date(item.created_at).toLocaleTimeString("uk-UA", {
                    hour: "2-digit",
                    minute: "2-digit"
                });
            });

            const chartData = {
                labels,
                datasets: [
                    {
                        label: "Температура",
                        data: history.map((item) => item.temperature),
                        borderColor: "#2563eb",
                        backgroundColor: "#2563eb",
                        tension: 0.3,
                        pointRadius: 2
                    },
                    {
                        label: "Вологість",
                        data: history.map((item) => item.humidity),
                        borderColor: "#0f766e",
                        backgroundColor: "#0f766e",
                        tension: 0.3,
                        pointRadius: 2
                    },
                    {
                        label: "Пил",
                        data: history.map((item) => item.dust),
                        borderColor: "#d94636",
                        backgroundColor: "#d94636",
                        tension: 0.3,
                        pointRadius: 2
                    },
                    {
                        label: "AQI",
                        data: history.map((item) => item.aqi),
                        borderColor: "#d99a00",
                        backgroundColor: "#d99a00",
                        tension: 0.3,
                        pointRadius: 2
                    }
                ]
            };

            if (historyChart) {
                historyChart.destroy();
            }

            historyChart = new Chart(canvas, {
                type: "line",
                data: chartData,
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            labels: {
                                boxWidth: 10,
                                color: "#42545d"
                            }
                        }
                    },
                    scales: {
                        x: {
                            ticks: {
                                color: "#53636d",
                                maxTicksLimit: 8
                            },
                            grid: {
                                display: false
                            }
                        },
                        y: {
                            ticks: {
                                color: "#53636d"
                            },
                            grid: {
                                color: "#e4ece8"
                            }
                        }
                    }
                }
            });
        }

        function matchesRange(value, min, max) {
            const numericValue = Number(value);

            if (!Number.isFinite(numericValue)) {
                return min === "" && max === "";
            }

            if (min !== "" && numericValue < Number(min)) {
                return false;
            }

            if (max !== "" && numericValue > Number(max)) {
                return false;
            }

            return true;
        }

        function matchesTime(value, hours) {
            if (hours === "all") {
                return true;
            }

            if (!value) {
                return false;
            }

            const measuredAt = new Date(value).getTime();
            const diffHours = (Date.now() - measuredAt) / (1000 * 60 * 60);

            return diffHours <= Number(hours);
        }

        function updateStats(items) {
            const activeSensors = items.filter((sensor) => matchesTime(sensor.last_measurement_at, "24"));
            const temperatureValues = numericValues(items, "temperature");
            const humidityValues = numericValues(items, "humidity");
            const dustValues = numericValues(items, "dust");
            const worstSensor = items
                .filter((sensor) => Number.isFinite(Number(sensor.dust)))
                .sort((a, b) => Number(b.dust) - Number(a.dust))[0];

            document.getElementById("filtered-count").textContent = `${items.length} датчиків`;
            document.getElementById("stat-total").textContent = items.length;
            document.getElementById("stat-active").textContent = activeSensors.length;
            document.getElementById("stat-temp").textContent = formatAverage(temperatureValues, " °C");
            document.getElementById("stat-humidity").textContent = formatAverage(humidityValues, " %");
            document.getElementById("stat-dust").textContent = formatAverage(dustValues, "");
            document.getElementById("stat-worst").textContent = worstSensor
                ? `${worstSensor.name} (${Number(worstSensor.dust).toFixed(1)})`
                : "—";
        }

        function numericValues(items, key) {
            return items
                .map((item) => Number(item[key]))
                .filter((value) => Number.isFinite(value));
        }

        function formatAverage(values, unit) {
            if (values.length === 0) {
                return "—";
            }

            const average = values.reduce((sum, value) => sum + value, 0) / values.length;
            return `${average.toFixed(1)}${unit}`;
        }

        function formatNumber(value, unit) {
            const numericValue = Number(value);

            if (!Number.isFinite(numericValue)) {
                return "немає даних";
            }

            return `${numericValue.toFixed(1)}${unit}`;
        }

        function getLevelLabel(level) {
            if (level === "low") return "низьке";
            if (level === "medium") return "середнє";
            if (level === "high") return "високе";
            return "немає даних";
        }
    </script>
</body>
</html>
