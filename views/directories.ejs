<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="app-layout">
        <aside class="side-toolbar" aria-label="Головна навігація">
            <div class="side-brand">
                <span class="side-logo">ІС</span>
                <div>
                    <strong>Аналіз повітря</strong>
                    <small>Міська система</small>
                </div>
            </div>

            <nav class="side-nav">
                <a href="/">Панель аналізу</a>
                <a href="/events">Журнал подій</a>
                <a class="active" href="/directories">Довідники</a>
            </nav>
        </aside>

        <main class="page">

        <section class="page-heading">
            <p class="eyebrow">Дані з PostgreSQL</p>
            <h1><%= pageTitle %></h1>
            <p class="description dark">
                На цій сторінці показані основні таблиці системи: перелік датчиків та останні вимірювання.
            </p>
        </section>

        <% if (error) { %>
            <div class="error-box"><%= error %></div>
        <% } %>

        <div class="directory-tabs" role="tablist" aria-label="Довідники">
            <button class="directory-tab active" type="button" data-tab="sensors" role="tab" aria-selected="true">
                Датчики
            </button>
            <button class="directory-tab" type="button" data-tab="measurements" role="tab" aria-selected="false">
                Останні вимірювання
            </button>
        </div>

        <section class="table-section directory-panel active" data-panel="sensors" role="tabpanel">
            <div class="section-header">
                <div>
                    <p class="eyebrow dark">Довідник 01</p>
                    <h2>Датчики</h2>
                </div>
                <span class="table-count"><%= sensors.length %> записів</span>
            </div>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Назва</th>
                            <th>Широта</th>
                            <th>Довгота</th>
                            <th>Створено</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (sensors.length === 0) { %>
                            <tr>
                                <td colspan="5" class="empty-cell">Дані відсутні</td>
                            </tr>
                        <% } %>

                        <% sensors.forEach((sensor) => { %>
                            <tr>
                                <td><%= sensor.id %></td>
                                <td><%= sensor.name %></td>
                                <td><%= Number(sensor.latitude).toFixed(5) %></td>
                                <td><%= Number(sensor.longitude).toFixed(5) %></td>
                                <td><%= new Date(sensor.created_at).toLocaleString("uk-UA") %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="table-section directory-panel" data-panel="measurements" role="tabpanel" hidden>
            <div class="section-header">
                <div>
                    <p class="eyebrow dark">Довідник 02</p>
                    <h2>Останні вимірювання</h2>
                </div>
                <span class="table-count"><%= measurements.length %> записів</span>
            </div>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Датчик</th>
                            <th>Температура</th>
                            <th>Вологість</th>
                            <th>Пил</th>
                            <th>AQI</th>
                            <th>Час</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (measurements.length === 0) { %>
                            <tr>
                                <td colspan="7" class="empty-cell">Дані відсутні</td>
                            </tr>
                        <% } %>

                        <% measurements.forEach((measurement) => { %>
                            <tr>
                                <td><%= measurement.id %></td>
                                <td><%= measurement.sensor_name || `ID ${measurement.sensor_id}` %></td>
                                <td><%= Number(measurement.temperature).toFixed(1) %> °C</td>
                                <td><%= Number(measurement.humidity).toFixed(1) %> %</td>
                                <td><%= Number(measurement.dust).toFixed(1) %></td>
                                <td><%= measurement.aqi === null ? "—" : Number(measurement.aqi).toFixed(1) %></td>
                                <td><%= new Date(measurement.created_at).toLocaleString("uk-UA") %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>
        </main>
    </div>

    <script>
        const tabs = document.querySelectorAll(".directory-tab");
        const panels = document.querySelectorAll(".directory-panel");

        tabs.forEach((tab) => {
            tab.addEventListener("click", () => {
                const selectedTab = tab.dataset.tab;

                tabs.forEach((item) => {
                    const isActive = item.dataset.tab === selectedTab;
                    item.classList.toggle("active", isActive);
                    item.setAttribute("aria-selected", String(isActive));
                });

                panels.forEach((panel) => {
                    const isActive = panel.dataset.panel === selectedTab;
                    panel.classList.toggle("active", isActive);
                    panel.hidden = !isActive;
                });
            });
        });
    </script>
</body>
</html>
